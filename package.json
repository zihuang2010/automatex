{
  "name": "tauri-app",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "package:doctor": "node scripts/package-doctor.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "package:mac": "bash scripts/build-macos.sh",
    "package:mac:intel": "bash scripts/build-macos.sh x86_64",
    "package:mac:arm": "bash scripts/build-macos.sh arm64",
    "package:win": "bash scripts/build-windows.sh",
    "lint": "eslint frontends/",
    "format": "prettier --write \"frontends/**/*.{ts,css,html}\" \"index.html\"",
    "format:check": "prettier --check \"frontends/**/*.{ts,css,html}\" \"index.html\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@csstools/postcss-color-mix-function": "^4.0.3",
    "@csstools/postcss-oklab-function": "^5.0.3",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.10.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/sortablejs": "^1.15.9",
    "eslint": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.0.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.5",
    "flatted": "^3.4.2",
    "lodash-es": "^4.18.1",
    "picomatch": "^4.0.4",
    "rollup": "^4.60.1",
    "yaml": "^2.8.3",
    "micromatch": {
      "picomatch": "^2.3.2"
    },
    "@trivago/prettier-plugin-sort-imports": {
      "brace-expansion": "^2.0.3",
      "lodash-es": "^4.18.1"
    }
  }
}
