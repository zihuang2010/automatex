{
    "name": "tauri-app",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "lint": "eslint src/",
        "format": "prettier --write \"src/**/*.{ts,css,html}\" \"index.html\"",
        "format:check": "prettier --check \"src/**/*.{ts,css,html}\" \"index.html\"",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{css,html,json,md}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.2.1",
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-opener": "^2",
        "tailwindcss": "^4.2.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tauri-apps/cli": "^2",
        "eslint": "^10.0.2",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "prettier": "^3.8.1",
        "typescript": "~5.6.2",
        "typescript-eslint": "^8.56.1",
        "vite": "^6.0.3"
    }
}
